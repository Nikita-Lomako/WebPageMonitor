@page "/watch"
@using static System.Net.WebRequestMethods
@layout MainLayout
@inject WatchedPageService WatchedPageService
@inject HttpClient Http


<h3>Настройка отслеживания</h3>

<!-- Email поле временно скрыто -->
@* <div class="form-group">
    <label>Email:</label>
    <input type="email" class="form-control" @bind="email" />
</div> *@

<div class="form-group mt-2">
    <label>Выберите сайт для отслеживания:</label>
    <select class="form-select" @bind="selectedPageId" disabled="@isTracking">
        <option value="">-- Выберите сайт --</option>
        @foreach (var watchedPage in watchedPages)
        {
            <option value="@watchedPage.Id">@GetPageName(watchedPage)</option>
        }
    </select>
</div>

<button class="btn btn-primary mt-3" @onclick="TrackPage" disabled="@(!CanTrack)">Отслеживать</button>

@if (isTracking)
{
    <p class="mt-3 text-success">Сайт отслеживается.</p>
    <button class="btn btn-danger" @onclick="UntrackPage">Остановить</button>
}

@if (showWarning)
{
    <div class="alert alert-warning mt-3">
        Выберите сайт для отслеживания.
    </div>
}

@code {
    private List<WatchedPage> watchedPages = new();
    private int? selectedPageId;
    private bool isTracking = false;
    private bool showWarning = false;

    private bool CanTrack => selectedPageId.HasValue;

    private System.Timers.Timer? checkTimer;


    protected override async Task OnInitializedAsync()
    {
        watchedPages = (await WatchedPageService.GetAllAsync()).ToList();
    }

    private string GetPageName(WatchedPage page)
    {
        if (page.Url.Contains("pass.rw.by"))
            return "RwBy (Расписание поездов)";
        if (page.Url.Contains("gismeteo.by"))
            return "Gismeteo (Погода)";
        return page.Url;
    }

    private async Task TrackPage()
    {
        if (!CanTrack)
        {
            showWarning = true;
            return;
        }

        showWarning = false;
        isTracking = true;

        if (selectedPageId.HasValue)
        {
            var page = watchedPages.First(p => p.Id == selectedPageId.Value);

            // Один запуск сразу
            await WatchedPageService.CheckUpdatesAsync(page);


            // Далее по таймеру
            checkTimer = new System.Timers.Timer(60000); // 60 сек
            checkTimer.Elapsed += async (s, e) => await WatchedPageService.CheckUpdatesAsync(page);

            checkTimer.AutoReset = true;
            checkTimer.Start();
        }
    }

    private async Task UntrackPage()
    {
        isTracking = false;

        checkTimer?.Stop();
        checkTimer?.Dispose();
        checkTimer = null;

        if (selectedPageId.HasValue)
            await WatchedPageService.StopTrackingAsync(selectedPageId.Value);
    }

}
